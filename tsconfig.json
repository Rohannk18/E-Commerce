{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": {
      "@shared/*": ["packages/shared/src/*"],
      "@web/*": ["apps/web/src/*"],
      "@api/*": ["apps/api/src/*"]
    }
  },
  "include": [
    "apps/web/src",
    "apps/api/src",
    "packages/shared/src"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ]
}